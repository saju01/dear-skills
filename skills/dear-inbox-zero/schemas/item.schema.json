{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "dear-inbox-zero item (one mail, invite or Teams message; metadata only)",
  "type": "object",
  "required": ["id"],
  "properties": {
    "id": {"type": "string"},
    "channel": {"enum": ["mail", "invite", "teams"], "default": "mail"},
    "thread_id": {"type": "string"},
    "message_id": {"type": "string", "description": "Original Graph Teams message id; item id is scoped by chat"},
    "received_at": {"type": "string", "format": "date-time"},
    "sender": {"type": "string", "description": "address, lower-case"},
    "sender_name": {"type": "string"},
    "sender_domain": {"type": "string"},
    "subject": {"type": "string"},
    "series": {"type": "string", "description": "normalised subject; filled by the engine if empty"},
    "to_me": {"type": "boolean"},
    "cc_only": {"type": "boolean"},
    "has_question": {"type": "boolean"},
    "deadline_hint": {"type": "string"},
    "is_read": {"type": "boolean"},
    "flagged": {"type": "boolean"},
    "categories": {"type": "array", "items": {"type": "string"}},
    "importance": {"enum": ["low", "normal", "high"]},
    "other_tab": {"type": "boolean"},
    "is_invite": {"type": "boolean"},
    "event_id": {"type": "string"},
    "organizer": {"type": "string"},
    "start": {"type": "string", "format": "date-time"},
    "end": {"type": "string", "format": "date-time"},
    "invitees": {"type": "integer"},
    "external": {"type": "boolean"},
    "is_series": {"type": "boolean"},
    "my_response": {"enum": ["none", "accepted", "tentative", "declined", "organizer"]},
    "mentions_me": {"type": "boolean"},
    "direct": {"type": "boolean"}
  }
}
