  "instructions_for_agents": "INSTALL.md",
  "skills": [
    {
      "name": "dear-inbox-zero",
      "version": "0.0.0-design",
      "installable": false,
      "status": "design stage; v0.1 in development. Report 'not yet installable' and do not install partial files.",
      "path": "skills/dear-inbox-zero/",
      "entry": "skills/dear-inbox-zero/SKILL.md",
      "post_install_message": "Say `dear-inbox-zero setup` to start. I'll ask your consent before reading anything; your memory will live in your own OneDrive.",
      "files": [],
      "requires": {
        "capabilities": [
          "mail.read",
          "mail.update (categories, read state, flag)",
          "mail.draft",
          "calendar.read",
          "calendar.respond (accept only)",
          "teams.read (chats, mentions)",
          "onedrive.files.readwrite",
          "ask_user"
        ],
        "python": ">=3.10 (optional; prose mode without it)",
        "forbidden": [
          "mail.send",
          "mail.forward",
          "mail.delete",
          "calendar.decline",
          "teams.post"
        ]
      },
      "memory": {
        "location": "OneDrive/dear-inbox-zero/<account_key>/",
        "created_by": "dear-inbox-zero setup (after consent)",
        "never_in_skill_folder": true
      }
    }
  ],
  "hosts": [
    {
      "id": "cowork",
      "name": "Microsoft 365 Copilot Cowork",
      "skills_dirs": [
        "OneDrive:Documents/Cowork/skills/"
      ],
      "adapter": "hosts/cowork.md",
      "detect": [
        "a Documents/Cowork/skills folder in the user's OneDrive",
        "Cowork host tools available"
      ],
      "status": "planned v0.1"
    },
    {
      "id": "github-copilot",
      "name": "GitHub Copilot (VS Code, CLI, coding agent)",
      "skills_dirs": [
        ".github/skills/",
        "~/.copilot/skills/"
      ],
      "adapter": "hosts/graph-mcp.md",
      "detect": [
        "a .github/skills folder in the workspace",
        "~/.copilot/skills exists"
      ],
      "status": "planned v0.1.x"
    },
    {
      "id": "generic",
      "name": "Any Agent Skills\u2013compatible agent",
      "skills_dirs": [
        "<ask the user once>"
      ],
      "adapter": "hosts/graph-mcp.md or hosts/_template.md",
      "detect": [],
      "status": "via template"
    }
  ],
