      "requires": {
        "capabilities": [
          "mail.read",
          "mail.update (categories, read state, flag)",
          "mail.draft",
          "calendar.read",
          "calendar.respond (accept only)",
          "teams.read (chats, mentions)",
          "onedrive.files.readwrite",
          "ask_user"
        ],
        "python": ">=3.10 (optional; prose mode without it)",
        "forbidden": [
          "mail.send",
          "mail.forward",
          "mail.delete",
          "calendar.decline",
          "teams.post"
        ]
      },
      "memory": {
        "location": "OneDrive/dear-inbox-zero/<account_key>/",
        "created_by": "dear-inbox-zero setup (after consent)",
        "never_in_skill_folder": true
      },
      "adapters": {
        "cowork": "hosts/cowork.md",
        "graph": "hosts/graph-mcp.md",
        "template": "hosts/_template.md"
      },
      "doctor": "python <target>/engine/dear_engine.py doctor --skill-dir <target>",
      "config_file": "config/host.json"
    }
  ],
